# API (apps/api)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/housekeeping
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_DAYS=7
PORT=3001
WEB_ORIGIN=http://localhost:3000

# S3-compatible (MinIO local: http://localhost:9000)
S3_REGION=us-east-1
S3_BUCKET=housekeeping
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123

# Optional: auto-assign interval for background job (ms)
AUTO_ASSIGN_INTERVAL_MS=60000

# EMMA reservation snapshot retention (days; default 730 = ~2 years)
EMMA_RESERVATION_RETENTION_DAYS=730
# Push local clean/inspected status to EMMA (set false to disable)
EMMA_ROOM_STATUS_PUSH=true
# Only push actions on or after this ISO timestamp (cutover — no backfill of historical cleans)
EMMA_ROOM_STATUS_PUSH_SINCE=2026-06-29T00:00:00Z
# Retry failed EMMA room-status pushes (default every 30 minutes)
EMMA_PUSH_RETRY_CRON=0 */30 * * * *

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Web Push (apps/api — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:housekeeping@localhost

# Puzzle / Puzzel CM scrape (apps/api Playwright — run: cd apps/api && npx playwright install chromium)
PUZZEL_BASE_URL=https://radissonemea.cm.puzzel.com
PUZZEL_TICKETS_PATH=/tickets
# Ticket filters (Saved Search, Team, Status, Time Period) are configured in PrizeBern → Puzzle.
# Cron sync runs every 15 min when Admin → Puzzle credentials exist. Set PUZZEL_AUTO_SYNC=false only to disable
# (e.g. local dev). Example below keeps automated sync off in dev; omit in production unless you need to turn it off.
PUZZEL_AUTO_SYNC=false
# Set false to debug with a visible Chromium window on the API host (not typical in production).
PUZZEL_HEADLESS=true
