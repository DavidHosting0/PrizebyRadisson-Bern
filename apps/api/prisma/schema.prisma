generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HOUSEKEEPER
  SUPERVISOR
  RECEPTION
  ADMIN
  TECHNICIAN
}

/** Shown in chat, headers, and assignments (independent of permission role). */
enum UserTitlePrefix {
  CLEANER
  HOUSEKEEPING_SUPERVISOR
  RECEPTION
  HTC_IN_TRAINING
  HTC
  ADMIN
  TECHNICIAN
}

/** Fine-grained access; merged with role + titlePrefix defaults + per-user grants. */
enum PermissionCode {
  ROOMS_READ
  ROOMS_UPDATE
  CHECKLIST_TASK_UPDATE
  CHECKLIST_REOPEN
  PHOTO_UPLOAD
  PHOTO_TIMELINE_READ
  ASSIGNMENT_READ
  ASSIGNMENT_CREATE
  ASSIGNMENT_SUGGESTIONS
  ASSIGNMENT_RUN_AUTO
  SERVICE_REQUEST_READ
  SERVICE_REQUEST_CREATE
  SERVICE_REQUEST_CLAIM
  SERVICE_REQUEST_PATCH
  SERVICE_REQUEST_CANCEL
  LOST_FOUND_READ
  LOST_FOUND_CREATE
  LOST_FOUND_UPDATE
  INSPECTION_CREATE
  ROOM_TYPE_READ
  ROOM_TYPE_WRITE
  FLOOR_PLAN_READ
  FLOOR_PLAN_WRITE
  ANALYTICS_READ
  TEAM_CHAT_READ
  TEAM_CHAT_POST
  USERS_READ
  USERS_READ_HOUSEKEEPERS
  USERS_WRITE
  USERS_DELETE
  SETTINGS_READ
  SETTINGS_WRITE
  DAMAGE_REPORT_CREATE
  DAMAGE_REPORT_READ
  DAMAGE_REPORT_UPDATE
  SHIFT_READ
  SHIFT_MANAGE
  RESERVATIONS_READ
  RESERVATIONS_SYNC
  MONITOR_MAP_READ
  ARRIVAL_CHECK
  GUIDE_READ
  GUIDE_WRITE
  ROOM_MANAGEMENT_READ
  SHIFT_HANDOVER_READ
  SHIFT_HANDOVER_WRITE
  SHIFT_NOTES_READ
  SHIFT_NOTES_WRITE
  COMPLAINTS_READ
  COMPLAINTS_WRITE
  LOANS_READ
  LOANS_WRITE
  LOANS_CATALOG_WRITE
  ACTIVITY_LOG_READ
}

enum ActivityLogCategory {
  AUTH
  USER
  ROOM
  CHECKLIST
  PHOTO
  SERVICE_REQUEST
  LOST_FOUND
  DAMAGE
  ASSIGNMENT
  INSPECTION
  SETTINGS
  ROLE
  FLOOR_PLAN
  TEAM_CHAT
  SHIFT
  RESERVATION
  EMMA
  ARRIVAL_CHECK
  GUIDE
  SHIFT_HANDOVER
  MONITOR_MAP
  ROOM_MANAGEMENT
  INTEGRATION
  NOTIFICATION
  SYSTEM
  OTHER
}

enum ReceptionHandoverShift {
  NIGHT
  MORNING
  LATE
}

enum GuestComplaintCategory {
  ROOM
  OTHER
}

enum GuestComplaintStatus {
  OPEN
  RESOLVED
}

enum MonitorMapFeedKind {
  NEWS
  POLICE
}

enum ChecklistTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ServiceRequestPriority {
  NORMAL
  URGENT
}

enum ServiceRequestStatus {
  CREATED
  OPEN
  CLAIMED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum LostFoundStatus {
  FOUND
  STORED
  CLAIMED
  CLOSED
}

enum RoomDamageType {
  FURNITURE
  FIXTURES
  WALL_OR_CEILING
  FLOOR
  WINDOW_OR_DOOR
  BATHROOM
  ELECTRICAL_OR_APPLIANCE
  OTHER
}

enum RoomDamageReportStatus {
  REPORTED
  ACKNOWLEDGED
  RESOLVED
}

enum AssignmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PhotoUploadStatus {
  PENDING
  READY
}

enum RoomHousekeepingEventKind {
  MARKED_CLEAN
  CHECKLIST_REOPENED
}

enum RoomGuestStaySource {
  CHECK_INS_DONE
  IN_HOUSE
  BACKFILL
}

enum TeamChatReactionType {
  THUMBS_UP
  CHECK_MARK
  HEART
  EYES
  EXCLAMATION_QUESTION
}

enum NotificationType {
  SERVICE_REQUEST_CREATED
  TEAM_CHAT_MENTION
}

enum ArrivalCheckRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ArrivalCheckItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
  NEEDS_MANUAL
}

enum ArrivalCheckStep {
  FOLIO_LOAD
  CHARGE_ASSIGN
  PREPAID_SETTLE
}

/// PrizeBern / Rezeption: Kategorisierung der Puzzel-Tickets (KI).
enum PuzzelTicketPrizeCategory {
  SPAM
  RECHNUNG_ANGEFRAGT
  RECHNUNGSKORREKTUR
  MEHRERE_RECHNUNGSANFRAGEN
  SONSTIGES
}

model HotelSettings {
  id        String   @id @default(cuid())
  name      String   @default("Prize by Radisson Bern")
  timezone  String   @default("UTC")
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt
}

/// Rows scraped from CM Puzzel (Radisson-hosted) ticket overview; rebuilt on each successful sync.
model PuzzelTicket {
  id          String   @id @default(cuid())
  /// Stable dedup key — prefer ticket href path hash, else deterministic fallback.
  externalKey String   @unique
  subject     String
  reference   String?
  status      String?
  /// Relative or absolute link to ticket details in Puzzel (if scraped).
  detailHref  String?
  /// Full visible row text (fallback search / auditing).
  rowSummary  String
  metadata    Json?
  scrapedAt   DateTime @default(now())
  messages    PuzzelTicketMessage[]
  analysis    PuzzelTicketAnalysis?

  @@index([scrapedAt])
}

/// Individual timeline email/message rows scraped from a Puzzel ticket detail page.
model PuzzelTicketMessage {
  id          String       @id @default(cuid())
  ticketId    String
  ticket      PuzzelTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  externalKey String       @unique
  sentAtText  String?
  fromText    String?
  toText      String?
  direction   String?
  bodyText    String
  bodyHtml    String?
  metadata    Json?
  scrapedAt   DateTime     @default(now())

  @@index([ticketId])
  @@index([scrapedAt])
}

/// AI-generated summary of a Puzzel ticket: detected request type and extracted booking details.
/// One row per ticket; rebuilt automatically when the underlying messages change.
model PuzzelTicketAnalysis {
  id                  String       @id @default(cuid())
  ticketId            String       @unique
  ticket              PuzzelTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// SHA-256 of externalKey + message contents (see `fingerprintMessages`). When new mail arrives or the hash algorithm version bumps, we re-run the AI.
  messagesFingerprint String
  /// 'invoice_correction' | 'invoice_resend' | 'invoice_other' | 'unknown'
  requestType         String
  /// Reception routing category (PrizeBern UI).
  prizeCategory       PuzzelTicketPrizeCategory @default(SONSTIGES)
  /// Short German one-liner that the receptionist sees first.
  summary             String
  /// { reservationNumber, roomNumber, checkInDate, checkOutDate, guestName, invoiceNumber, otherDetails }
  bookingDetails      Json
  /// Verbose AI rationale + raw extracted fields (for debugging).
  details             Json
  /// AI model identifier used for this analysis (e.g. "gpt-4o-mini").
  model               String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([ticketId])
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  phone        String?
  isActive     Boolean         @default(true)
  role         UserRole
  titlePrefix  UserTitlePrefix @default(CLEANER)
  /// Object-storage key for the user's avatar photo. URLs are resolved on read via presigned GETs.
  avatarS3Key  String?
  /// UI and chat translation locale (`de` | `en`).
  preferredLocale String @default("de")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  refreshTokens      RefreshToken[]
  cleaningSessions   CleaningSession[] @relation("AssignedSessions")
  roomChecklistTasks RoomChecklistTask[]
  roomPhotos         RoomPhoto[]
  serviceRequestsCreated ServiceRequest[] @relation("CreatedBy")
  serviceRequestsClaimed ServiceRequest[] @relation("ClaimedBy")
  lostFoundReported  LostFoundItem[]
  damageReportsReported RoomDamageReport[]
  shifts             Shift[]
  roomAssignmentsAsHousekeeper RoomAssignment[] @relation("HousekeeperAssignment")
  roomAssignmentsAsAssigner    RoomAssignment[] @relation("AssignerAssignment")
  inspections        RoomInspection[]
  // Admin can maintain custom floor-plan layouts.
  floorPlansUpdated  FloorPlan[]
  teamChatMessages         TeamChatMessage[]
  teamChatMessageReactions TeamChatMessageReaction[]
  teamChatMentions         TeamChatMessageMention[]
  notifications            Notification[]
  pushSubscriptions        PushSubscription[]
  permissionGrants         UserPermissionGrant[]
  roleAssignments          UserRoleAssignment[]
  favurMap                 FavurUserMap[]
  arrivalCheckRuns         ArrivalCheckRun[]
  guidesCreated            Guide[] @relation("GuideCreatedBy")
  guidesUpdated            Guide[] @relation("GuideUpdatedBy")
  roomHousekeepingEvents   RoomHousekeepingEvent[]
  activityLogs             ActivityLog[]
  shiftNotesCreated        ShiftNote[]              @relation("ShiftNoteCreatedBy")
  complaintsCreated        GuestComplaint[]         @relation("ComplaintCreatedBy")
  complaintsResolved       GuestComplaint[]         @relation("ComplaintResolvedBy")
  roomLoansLoaned          RoomLoan[]               @relation("RoomLoanLoanedBy")
  roomLoansReturned        RoomLoan[]               @relation("RoomLoanReturnedBy")
}

/**
 * Admin-defined custom roles (Discord-style). Account type (`User.role`) controls
 * which UI shell the user sees; feature permissions come from assigned roles
 * plus optional per-user grants. ADMIN accounts receive every permission.
 */
model Role {
  id          String               @id @default(cuid())
  name        String               @unique
  /// Hex color (with leading #) shown as a chip/dot in the UI.
  color       String               @default("#99aab5")
  /// Higher = sorted toward the top in role lists. Non-negative.
  position    Int                  @default(0)
  description String?
  /// Built-in role; protected from deletion through the API.
  isSystem    Boolean              @default(false)
  permissions RolePermission[]
  members     UserRoleAssignment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([position])
}

model RolePermission {
  id         String         @id @default(cuid())
  roleId     String
  role       Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PermissionCode
  createdAt  DateTime       @default(now())

  @@unique([roleId, permission])
  @@index([roleId])
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model UserPermissionGrant {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission PermissionCode
  createdAt  DateTime       @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RoomType {
  id                         String              @id @default(cuid())
  name                       String
  code                       String              @unique
  defaultChecklistTemplateId String?
  defaultChecklistTemplate   ChecklistTemplate?  @relation(fields: [defaultChecklistTemplateId], references: [id])
  rooms                      Room[]
  checklistTemplates         ChecklistTemplate[] @relation("RoomTypeTemplates")
}

model ChecklistTemplate {
  id          String   @id @default(cuid())
  name        String
  version     Int      @default(1)
  roomTypeId  String?
  roomType    RoomType? @relation("RoomTypeTemplates", fields: [roomTypeId], references: [id], onDelete: SetNull)
  tasks       ChecklistTemplateTask[]
  states      RoomChecklistState[]
  roomTypesDefault RoomType[]
}

model ChecklistTemplateTask {
  id          String            @id @default(cuid())
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder   Int
  label       String
  code        String
  required    Boolean           @default(true)
  roomTasks   RoomChecklistTask[]

  @@unique([templateId, code])
  @@index([templateId])
}

model Room {
  id          String   @id @default(cuid())
  roomNumber  String   @unique
  floor       Int?
  roomTypeId  String
  roomType    RoomType @relation(fields: [roomTypeId], references: [id])
  outOfOrder  Boolean  @default(false)
  oooReason   String?
  oooUntil    DateTime?
  notes       String?
  metadata    Json     @default("{}")
  /** Set when assigned housekeeper confirms clean. Drives derived CLEAN vs IN_PROGRESS. */
  cleaningDeclaredAt DateTime?

  checklistStates  RoomChecklistState[]
  cleaningSessions CleaningSession[]
  photos           RoomPhoto[]
  serviceRequests  ServiceRequest[]
  lostFoundItems   LostFoundItem[]
  damageReports    RoomDamageReport[]
  assignments      RoomAssignment[]
  inspections      RoomInspection[]
  housekeepingEvents RoomHousekeepingEvent[]
  emmaStatusPushOutbox EmmaRoomStatusPushOutbox[]
  guestStays         RoomGuestStay[]
  guestComplaints    GuestComplaint[]
  roomLoans          RoomLoan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Failed EMMA room-status pushes — retried every 30 minutes until success.
model EmmaRoomStatusPushOutbox {
  id          String    @id @default(cuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  targetCode  String
  source      String
  actionAt    DateTime
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([resolvedAt, nextRetryAt])
  @@index([roomId])
}

model RoomHousekeepingEvent {
  id         String                    @id @default(cuid())
  roomId     String
  room       Room                      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User                      @relation(fields: [userId], references: [id])
  kind       RoomHousekeepingEventKind
  occurredAt DateTime                  @default(now())

  @@index([roomId, occurredAt])
}

model RoomChecklistState {
  id         String            @id @default(cuid())
  roomId     String
  room       Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id])
  updatedAt  DateTime          @updatedAt
  tasks      RoomChecklistTask[]

  @@unique([roomId])
}

model RoomChecklistTask {
  id                 String              @id @default(cuid())
  stateId            String
  state              RoomChecklistState  @relation(fields: [stateId], references: [id], onDelete: Cascade)
  templateTaskId     String
  templateTask       ChecklistTemplateTask @relation(fields: [templateTaskId], references: [id])
  status             ChecklistTaskStatus @default(NOT_STARTED)
  updatedByUserId    String?
  updatedBy          User?               @relation(fields: [updatedByUserId], references: [id])
  updatedAt          DateTime            @updatedAt
  supervisorOverride Boolean             @default(false)

  @@unique([stateId, templateTaskId])
}

model CleaningSession {
  id              String    @id @default(cuid())
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedUserId  String
  assignedUser    User      @relation("AssignedSessions", fields: [assignedUserId], references: [id])
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  photos RoomPhoto[]

  @@index([roomId])
  @@index([assignedUserId])
}

model RoomInspection {
  id              String   @id @default(cuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inspectorUserId String
  inspector       User     @relation(fields: [inspectorUserId], references: [id])
  inspectedAt     DateTime @default(now())
  notes           String?
  passed          Boolean  @default(true)
  photos          RoomPhoto[]

  @@index([roomId])
}

model RoomPhoto {
  id                 String            @id @default(cuid())
  roomId             String
  room               Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  uploadedByUserId   String
  uploadedBy         User              @relation(fields: [uploadedByUserId], references: [id])
  s3Key              String
  mime               String?
  bytes              Int?
  takenAt            DateTime?
  status             PhotoUploadStatus @default(PENDING)
  cleaningSessionId  String?
  cleaningSession    CleaningSession?  @relation(fields: [cleaningSessionId], references: [id])
  roomInspectionId   String?
  roomInspection     RoomInspection?   @relation(fields: [roomInspectionId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())

  @@index([roomId])
  @@index([roomInspectionId])
}

model ServiceRequestType {
  id                         String   @id @default(cuid())
  code                       String   @unique
  label                      String
  mapsToChecklistTaskCode    String?

  requests ServiceRequest[]
}

model ServiceRequest {
  id                String                 @id @default(cuid())
  roomId            String
  room              Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  typeId            String
  type              ServiceRequestType     @relation(fields: [typeId], references: [id])
  priority          ServiceRequestPriority @default(NORMAL)
  description       String?
  status            ServiceRequestStatus   @default(CREATED)
  createdByUserId   String
  createdBy         User                   @relation("CreatedBy", fields: [createdByUserId], references: [id])
  claimedByUserId   String?
  claimedBy         User?                  @relation("ClaimedBy", fields: [claimedByUserId], references: [id])
  claimedAt         DateTime?
  resolvedAt        DateTime?
  version           Int                    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([roomId])
}

model LostFoundItem {
  id                 String         @id @default(cuid())
  roomId             String?
  room               Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reportedByUserId   String
  reportedBy         User           @relation(fields: [reportedByUserId], references: [id])
  description        String
  photoS3Key         String?
  status             LostFoundStatus @default(FOUND)
  /// Set when a housekeeper reports the item. Null when reception backfills an existing storage item.
  foundAt            DateTime?
  storedAt           DateTime?
  storedLocation     String?
  guestContactedAt   DateTime?
  claimedByGuestInfo Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model RoomDamageReport {
  id                 String                 @id @default(cuid())
  roomId             String
  room               Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reportedByUserId   String
  reportedBy         User                   @relation(fields: [reportedByUserId], references: [id])
  damageType         RoomDamageType
  description        String
  photoS3Key         String
  status             RoomDamageReportStatus @default(REPORTED)
  reportedAt         DateTime               @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([roomId])
}

model Shift {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  /// Where the row originated. "manual" for hand entries, "mirus" for Mirus NEO sync.
  source    String   @default("manual")
  /// External id from the source system (e.g. Mirus shift id). Lets us upsert.
  sourceId  String?
  /// Free-form label (shift code, location, role, etc.).
  label     String?
  /// Hex color for the chip on the roster (defaults to user's role color).
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([userId, startsAt, endsAt])
  @@index([startsAt, endsAt])
}

/// Singleton config for Mirus NEO shift import (table name historical: FavurIntegration).
/// Server logs in with mirusUsername/password and scrapes the Dienstplan.
model FavurIntegration {
  id                 String    @id @default("default")
  enabled            Boolean   @default(false)
  baseUrl            String    @default("https://neo.mirus.ch")

  /// Shared secret the extension uses to authenticate when posting captures.
  apiKey             String?   @unique

  /// Active request template (from the most recently chosen FavurCapture).
  activeCaptureId    String?
  activeUrl          String?
  activeMethod       String?
  /// Encrypted JSON: { headerName: value, ... } — replayed on every sync.
  activeHeaders      String?
  /// Encrypted cookie string ("a=1; b=2"), captured via chrome.cookies API
  /// so HttpOnly cookies are included.
  activeCookies      String?
  /// Optional encrypted body for POST requests.
  activeBody         String?
  activeCapturedAt   DateTime?

  /// JSONPath-ish dot path into the response for the shifts array.
  /// "" means "response is itself the shifts array".
  shiftsJsonPath     String    @default("")
  fieldShiftId       String    @default("id")
  fieldUserId        String    @default("user.id")
  fieldUserName      String    @default("user.fullName")
  fieldStartsAt      String    @default("startsAt")
  fieldEndsAt        String    @default("endsAt")
  fieldLabel         String?

  /// Sync window in days, looking forward from "today".
  windowDays         Int       @default(14)

  /// Mirus NEO server-side login (neo.mirus.ch) — no browser extension required.
  mirusUsername        String?
  mirusPasswordEnc     String?
  mirusSessionEnc      String?
  mirusSessionSavedAt  DateTime?

  lastSyncAt         DateTime?
  lastSyncStatus     String?
  lastSyncError      String?
  lastSyncCount      Int       @default(0)
  /// True while a sync is currently running (advisory lock).
  syncInProgress     Boolean   @default(false)
  /// When the current sync claimed the lock (used to clear stale locks).
  syncStartedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Legacy capture table from the removed browser extension (unused by Mirus sync).
model FavurCapture {
  id              String   @id @default(cuid())
  url             String
  method          String   @default("GET")
  headers         String   // encrypted JSON
  cookies         String   // encrypted cookie string
  body            String?  // encrypted (POST/PUT requests)
  responseStatus  Int
  /// Encrypted, truncated response body (first 64 KB) — used for previewing
  /// in the admin UI and for auto-detecting which capture is the shift list.
  responseSample  String
  responseShape   String?  // hint string (e.g. "array<10> with date fields")
  capturedAt      DateTime @default(now())
  capturedFrom    String?  // optional user/host hint from extension

  @@index([capturedAt])
}

/// Mapping from Mirus employee identifier to a local User (table name historical).
/// Rows are created the first time we see a Mirus person; admins map them to local accounts.
model FavurUserMap {
  id               String    @id @default(cuid())
  favurUserId      String    @unique
  favurDisplayName String?
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

model RoomAssignment {
  id                  String           @id @default(cuid())
  roomId              String
  room                Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  housekeeperUserId   String
  housekeeper         User             @relation("HousekeeperAssignment", fields: [housekeeperUserId], references: [id])
  assignedByUserId    String?
  assigner            User?            @relation("AssignerAssignment", fields: [assignedByUserId], references: [id])
  assignedAt          DateTime         @default(now())
  status              AssignmentStatus @default(PENDING)

  @@index([roomId])
  @@index([housekeeperUserId])
}

model AnalyticsDaily {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  metricKey String
  value     Float
  meta      Json     @default("{}")

  @@unique([date, metricKey])
}

model FloorPlan {
  id              String   @id @default(cuid())
  floor           Int      @unique
  layout          Json     @default("[]")
  updatedByUserId String?
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TeamChatMessage {
  id        String   @id @default(cuid())
  body      String   @db.VarChar(2000)
  /// Detected language when posted (`de` | `en` | …).
  sourceLocale String?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyToId String?
  replyTo   TeamChatMessage? @relation("TeamChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   TeamChatMessage[] @relation("TeamChatReplies")
  reactions TeamChatMessageReaction[]
  mentions  TeamChatMessageMention[]
  translations TeamChatMessageTranslation[]
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([replyToId])
}

model TeamChatMessageTranslation {
  id        String          @id @default(cuid())
  messageId String
  message   TeamChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  locale    String
  body      String          @db.VarChar(2000)
  createdAt DateTime        @default(now())

  @@unique([messageId, locale])
  @@index([messageId])
}

model TeamChatMessageMention {
  id        String          @id @default(cuid())
  messageId String
  message   TeamChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  linkPath  String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model TeamChatMessageReaction {
  id        String               @id @default(cuid())
  messageId String
  message   TeamChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TeamChatReactionType
  createdAt DateTime             @default(now())

  @@unique([messageId, userId, type])
  @@index([messageId])
}

model ReservationSnapshot {
  id            String   @id @default(cuid())
  hotelId       String
  reservationId String
  arrivalDate   DateTime @db.Date
  departureDate DateTime @db.Date
  roomId        String?
  checkIn       Boolean  @default(false)
  checkOut      Boolean  @default(false)
  checkInQueue  Boolean  @default(false)
  inTodayArrivals Boolean @default(false)
  inCheckInDone Boolean  @default(false)
  checkInBusinessDate DateTime? @db.Date
  nightsStay    Int?
  roomType      String?
  mealPlan      String?
  tier          String?
  numPax        Int?
  sensitiveEnc  String   @db.Text
  detailEnc     String?  @db.Text
  detailFetchedAt DateTime?
  folioEnc      String?  @db.Text
  folioFetchedAt DateTime?
  arrivalCheckCompletedAt   DateTime?
  arrivalCheckLastRunId     String?
  arrivalCheckLastRunItemId String?
  syncedAt      DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([hotelId, reservationId])
  @@index([hotelId, arrivalDate, checkIn, checkInQueue])
  @@index([hotelId, arrivalDate, inTodayArrivals])
  @@index([hotelId, inTodayArrivals])
  @@index([hotelId, checkInQueue, checkIn])
  @@index([hotelId, inCheckInDone])
  @@index([hotelId, checkIn, checkOut])
  @@index([hotelId, departureDate, checkIn])
  @@index([hotelId, reservationId])
  @@index([hotelId, arrivalCheckCompletedAt])
  @@index([roomId, departureDate])
}

/// Immutable guest-in-room history for Room Management (fed from EMMA sync).
model RoomGuestStay {
  id                    String              @id @default(cuid())
  hotelId               String
  reservationId         String
  roomNumber            String
  roomId                String?
  room                  Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  arrivalDate           DateTime            @db.Date
  departureDate         DateTime            @db.Date
  checkInAt             DateTime?
  checkOutAt            DateTime?
  checkedOut            Boolean             @default(false)
  mainGuestNameEnc      String              @db.Text
  stayover              Boolean             @default(false)
  expectedDepartureTime   String?
  source                RoomGuestStaySource
  lastSeenAt            DateTime
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([roomNumber, departureDate])
  @@index([hotelId, reservationId])
  @@index([departureDate])
  @@index([hotelId, reservationId, checkedOut])
}

model ReservationSyncRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String
  tab        String?
  rowCount   Int?
  error      String?   @db.Text
  overview   Json?

  @@index([startedAt])
}

model ArrivalCheckRun {
  id              String                @id @default(cuid())
  hotelId         String
  createdByUserId String
  createdBy       User                  @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  status          ArrivalCheckRunStatus @default(RUNNING)
  /** When true, reservations marked as completed earlier are processed again. */
  forceRerun      Boolean               @default(false)
  startedAt       DateTime              @default(now())
  finishedAt      DateTime?
  items           ArrivalCheckRunItem[]

  @@index([startedAt])
  @@index([createdByUserId])
}

model ArrivalCheckRunItem {
  id            String                 @id @default(cuid())
  runId         String
  run           ArrivalCheckRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  reservationId String
  hotelId       String
  status        ArrivalCheckItemStatus @default(PENDING)
  currentStep   ArrivalCheckStep?
  error         String?                @db.Text
  startedAt     DateTime?
  finishedAt    DateTime?
  source        String?
  scenario      String?
  categoryLabel String?
  statusMessage String?                @db.Text
  manualReason  String?                @db.Text
  movesPlanned  Int                    @default(0)
  movesDone     Int                    @default(0)
  paymentStatus String?
  paymentAmount String?
  paymentExpectedAmount String?
  paymentCardMask String?
  paymentInvoice String?
  paymentError  String?                @db.Text
  /** Set when this item was auto-skipped because an earlier run completed the same reservation. */
  alreadyCompletedAt    DateTime?
  alreadyCompletedRunId String?

  @@unique([runId, reservationId])
  @@index([runId])
}

model MonitorMapFeedSource {
  id        String             @id @default(cuid())
  kind      MonitorMapFeedKind
  name      String
  feedUrl   String
  enabled   Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model MonitorMapNewsItem {
  id            String   @id @default(cuid())
  sourceId      String
  externalId    String
  title         String
  summary       String?
  url           String
  publishedAt   DateTime
  latitude      Float?
  longitude     Float?
  locationLabel String?
  aiAnalysis    Json?
  geocodeStatus String?
  createdAt     DateTime @default(now())

  @@unique([sourceId, externalId])
  @@index([publishedAt])
}

model MonitorMapPoliceItem {
  id            String   @id @default(cuid())
  sourceId      String
  externalId    String
  title         String
  summary       String?
  url           String
  publishedAt   DateTime
  latitude      Float?
  longitude     Float?
  locationLabel String?
  geocodeStatus String?
  createdAt     DateTime @default(now())

  @@unique([sourceId, externalId])
  @@index([publishedAt])
}

model ShiftHandoverTemplateTask {
  id        String                 @id @default(cuid())
  shift     ReceptionHandoverShift
  label     String
  code      String
  sortOrder Int                    @default(0)
  essential Boolean                @default(false)

  @@unique([shift, code])
  @@index([shift, sortOrder])
}

model ShiftHandoverState {
  id                   String                 @id @default("singleton")
  activeShift          ReceptionHandoverShift @default(NIGHT)
  completions          Json                   @default("{}")
  lastHandoverAt       DateTime?
  lastHandoverByUserId String?
  updatedAt            DateTime               @updatedAt
}

model ShiftHandoverLog {
  id                 String                 @id @default(cuid())
  fromShift          ReceptionHandoverShift
  toShift            ReceptionHandoverShift
  handedOverByUserId String
  incompleteCount    Int
  snapshot           Json
  createdAt          DateTime               @default(now())

  @@index([createdAt])
}

/// Reception shift notebook entries (separate from the To-Do checklist).
model ShiftNote {
  id              String                   @id @default(cuid())
  forDate         DateTime                 @db.Date
  shifts          ReceptionHandoverShift[]
  body            String                   @db.Text
  createdByUserId String
  createdBy       User                     @relation("ShiftNoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([forDate])
  @@index([createdAt])
}

model GuestComplaint {
  id                 String                 @id @default(cuid())
  category           GuestComplaintCategory
  roomId             String?
  room               Room?                  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  description        String                 @db.Text
  status             GuestComplaintStatus   @default(OPEN)
  createdByUserId    String
  createdBy          User                   @relation("ComplaintCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  resolvedAt         DateTime?
  resolvedByUserId   String?
  resolvedBy         User?                  @relation("ComplaintResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([roomId])
  @@index([createdAt])
  @@index([category])
  @@index([status])
}

model LoanItemCatalogEntry {
  id           String     @id @default(cuid())
  name         String
  depositCents Int
  active       Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  loans        RoomLoan[]

  @@index([active, sortOrder])
}

model RoomLoan {
  id              String               @id @default(cuid())
  roomId          String
  room            Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  catalogItemId   String
  catalogItem     LoanItemCatalogEntry @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  depositCents    Int
  loanedAt        DateTime             @default(now())
  loanedByUserId  String
  loanedBy        User                 @relation("RoomLoanLoanedBy", fields: [loanedByUserId], references: [id], onDelete: Restrict)
  returnedAt      DateTime?
  returnedByUserId String?
  returnedBy      User?                @relation("RoomLoanReturnedBy", fields: [returnedByUserId], references: [id], onDelete: SetNull)

  @@index([returnedAt])
  @@index([roomId])
  @@index([catalogItemId])
}

model Guide {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  summary         String?
  body            String   @db.Text
  category        String?
  sortOrder       Int      @default(0)
  published       Boolean  @default(false)
  createdByUserId String
  createdBy       User     @relation("GuideCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId String?
  updatedBy       User?    @relation("GuideUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([category])
}

model ActivityLog {
  id           String              @id @default(cuid())
  createdAt    DateTime            @default(now())
  action       String
  label        String
  category     ActivityLogCategory
  actorUserId  String?
  actor        User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail   String?
  actorName    String?
  method       String
  path         String
  resourceType String?
  resourceId   String?
  statusCode   Int?
  success      Boolean             @default(true)
  errorMessage String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  durationMs   Int?

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId])
  @@index([action])
  @@index([category])
  @@index([resourceType, resourceId])
}
