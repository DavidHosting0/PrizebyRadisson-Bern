{
  "manifest_version": 3,
  "name": "PrizeBern Panel",
  "version": "1.0.0",
  "description": "PrizeBern Housekeeping side panel: shift handover checklist on any website.",
  "homepage_url": "https://prizebern.com/extension-install",
  "permissions": ["storage"],
  "host_permissions": ["https://prizebern.com/*"],
  "optional_host_permissions": ["http://localhost:3001/*"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/inject.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/panel/index.html", "assets/*", "PrizeByRadisson.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "public/icon-16.png",
    "48": "public/icon-48.png",
    "128": "public/icon-128.png"
  },
  "action": {
    "default_title": "PrizeBern Panel",
    "default_icon": {
      "16": "public/icon-16.png",
      "48": "public/icon-48.png"
    }
  }
}
