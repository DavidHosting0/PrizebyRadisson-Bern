{
  "manifest_version": 3,
  "name": "PrizeBern Panel",
  "version": "1.0.0",
  "description": "PrizeBern Housekeeping Sidepanel — Schichtübergabe und mehr, auf jeder Website.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://prizebern.com/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/inject.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/panel/index.html", "assets/*", "PrizeByRadisson.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "128": "public/icon-128.png"
  }
}
